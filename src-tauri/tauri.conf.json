{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopGadget",
  "version": "1.1.0",
  "identifier": "local.desktopgadget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DesktopGadget",
        "width": 480,
        "height": 520,
        "x": 40,
        "y": 40,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "すりガラス風のデスクトップガジェット（時計・天気・使用量）",
    "longDescription": "時計、天気・警報・雨雲レーダー、CPU・GPU・RAM、温度、ネットワークを、デスクトップにすりガラス風のカードで表示します。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "DesktopGadget",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}