{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopGadget",
  "version": "0.1.0",
  "identifier": "local.desktopgadget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DesktopGadget",
        "width": 480,
        "height": 520,
        "x": 40,
        "y": 40,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}